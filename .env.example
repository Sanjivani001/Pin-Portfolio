# Copy this file to .env, then set these values before starting the server.
# CONTACT_EMAIL is the inbox that should receive enquiry submissions.
CONTACT_EMAIL=sanju010305@gmail.com

# Use an email address/domain verified with Resend.
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Create this key in your Resend account. Never expose it in browser code.
RESEND_API_KEY=re_replace_with_your_server_side_key

# Generate this using: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Admin user bootstrap: generate the password hash with `node server.js hash-password`.
# These values only create the first admin; the password hash is then stored in SQLite.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Keep database files outside the public static file allow-list.
DATABASE_PATH=data/portfolio.sqlite

# Optional; defaults to port 3000.
PORT=3000
